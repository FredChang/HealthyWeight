<Window x:Class="HealthyWeight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="體重飲食管理 (HealthyWeight) — 桌面版" Height="760" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：身體素質與飲食管理設定 -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🥗 身體素質與飲食設定" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                    <TextBlock Text="生理性別" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="MaleRadio" Content="👨 男性" GroupName="Gender" Margin="0,0,20,0" Checked="Input_Changed"/>
                        <RadioButton x:Name="FemaleRadio" Content="👩 女性" GroupName="Gender" IsChecked="True" Checked="Input_Changed"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="年齡 (歲)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="AgeBox" Text="30" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="身高 (cm)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="HeightBox" Text="162" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="目前體重 (kg)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="WeightBox" Text="64.0" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="目標體重 (kg)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox x:Name="TargetWeightBox" Text="56.0" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="Input_Changed"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="日常活動與運動量" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ActivityCombo" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12" SelectionChanged="Input_Changed">
                        <ComboBoxItem Content="🪑 久坐不動 (x1.2)" Tag="1.2"/>
                        <ComboBoxItem Content="🚶 輕度活動 1~3天運動 (x1.375)" Tag="1.375" IsSelected="True"/>
                        <ComboBoxItem Content="🏃 中度運動 3~5天運動 (x1.55)" Tag="1.55"/>
                        <ComboBoxItem Content="🏋️ 高度運動 6~7天訓練 (x1.725)" Tag="1.725"/>
                    </ComboBox>

                    <TextBlock Text="挑選飲食管理方法" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MethodCombo" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,8" SelectionChanged="Method_Changed"/>
                    <TextBlock x:Name="MethodDescText" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                    <TextBlock x:Name="DurationLabel" Text="預定施行時間：8 週 (56 天)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Slider x:Name="WeeksSlider" Minimum="1" Maximum="36" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Input_Changed" Margin="0,0,0,14"/>

                    <Button x:Name="CalcButton" Content="🚀 重新計算與隨機換套餐" Height="40" Background="#059669" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CalcButton_Click" Margin="0,0,0,8"/>
                    <Button x:Name="OpenWebButton" Content="🌐 用瀏覽器開啟完整互動網頁版" Height="34" Background="#EFF6FF" Foreground="#1D4ED8" FontWeight="SemiBold" BorderBrush="#BFDBFE" BorderThickness="1" Cursor="Hand" Click="OpenWebButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右側：減重數值計算結果與飲食套餐列表 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 頂部減重預測卡片 -->
            <Border Grid.Row="0" Background="#065F46" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="HeroTitleText" Text="168 間歇性斷食 · 預定施行 8 週" Foreground="#A7F3D0" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="HeroLossText" Text="-4.2 kg" Foreground="White" FontSize="36" FontWeight="ExtraBold" Margin="0,4,0,4"/>
                        <TextBlock x:Name="HeroWeightRangeText" Text="64.0 kg ➔ 59.8 kg (BMI 24.4 ➔ 22.8)" Foreground="#ECFDF5" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatBmrTdeeText" Text="BMR: 1350 kcal | TDEE: 1856 kcal" Foreground="White" FontSize="13" Margin="0,2"/>
                        <TextBlock x:Name="StatTargetKcalText" Text="🎯 建議每日攝取: 1380 kcal" Foreground="#6EE7B7" FontSize="14" FontWeight="Bold" Margin="0,2"/>
                        <TextBlock x:Name="StatMacrosText" Text="🥩 P: 104g | 🍠 C: 138g | 🥑 F: 46g" Foreground="White" FontSize="13" Margin="0,2"/>
                        <TextBlock x:Name="StatWaterText" Text="💧 建議每日飲水: 2240 ml" Foreground="#E0F2FE" FontSize="13" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 下方推薦飲食套餐清單 -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🍱 推薦一日減脂飲食套餐（依目標熱量自動提供份量調整建議）" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MealsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="Bold" Foreground="#065F46" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Advice}" FontSize="12.5" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Body}" FontSize="13" Foreground="#334155" TextWrapping="Wrap" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
